<%- include('../partials/layout_start') %>

<div class="page-heading mb-4">
  <%= role === 'Employee' ? 'My Task Files' : 'File Repository' %>
</div>

<!-- Filter bar (Admin + Manager only) -->
<% if (role !== 'Employee') { %>
<form method="GET" action="<%= basePath %>/files" class="d-flex flex-wrap gap-2 mb-4">
  <input type="text" name="search" class="form-control form-control-sm" style="width:200px;"
         placeholder="Search file name…" value="<%= query.search %>" />
  <select name="task_id" class="form-select form-select-sm" style="width:220px;">
    <option value="">All Tasks</option>
    <% (tasks || []).forEach(t => { %>
      <option value="<%= t.task_id %>" <%= query.task_id == t.task_id ? 'selected' : '' %>>
        <%= t.task_title.length > 40 ? t.task_title.slice(0,40)+'…' : t.task_title %>
      </option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-outline-secondary btn-sm">Filter</button>
  <a href="<%= basePath %>/files" class="btn btn-outline-secondary btn-sm">Clear</a>
</form>
<% } %>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 small">
      <thead class="table-light">
        <tr>
          <th>File Name</th>
          <th>Type</th>
          <th>Task</th>
          <% if (role !== 'Employee') { %><th>Uploaded By</th><% } %>
          <th>Date</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!files || files.length === 0) { %>
          <tr>
            <td colspan="<%= role !== 'Employee' ? 6 : 5 %>"
                class="text-center py-5 text-muted">
              <i class="bi bi-folder2-open d-block fs-2 mb-2 opacity-50"></i>
              No files yet.
            </td>
          </tr>
        <% } %>
        <% (files || []).forEach(f => { %>
          <tr>
            <td>
              <i class="bi bi-file-earmark text-muted me-1"></i>
              <span class="fw-semibold">
                <%= f.file_name.length > 36 ? f.file_name.slice(0,36)+'…' : f.file_name %>
              </span>
            </td>
            <td>
              <span class="badge bg-secondary-subtle text-secondary">
                <%= (f.file_type || '?').toUpperCase() %>
              </span>
            </td>
            <td class="text-muted">
              <%= f.task ? (f.task.task_title.length > 30 ? f.task.task_title.slice(0,30)+'…' : f.task.task_title) : '—' %>
            </td>
            <% if (role !== 'Employee') { %>
            <td class="text-muted">
              <% if (f.uploadedBy && f.uploadedBy.employee) { %>
                <%= f.uploadedBy.employee.first_name %> <%= f.uploadedBy.employee.last_name %>
              <% } else if (f.uploadedBy) { %>
                <%= f.uploadedBy.username %>
              <% } else { %>—<% } %>
            </td>
            <% } %>
            <td class="text-muted">
              <%= new Date(f.uploaded_at).toLocaleDateString() %>
            </td>
            <td class="text-end">
              <a href="/attachments/<%= f.attachment_id %>/download"
                 class="btn btn-sm btn-outline-primary py-0 px-2"
                 title="Download <%= f.file_name %>">
                <i class="bi bi-download"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pages > 1) { %>
  <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top small">
    <span class="text-muted">Page <%= page %> of <%= pages %> (<%= total %> files)</span>
    <div class="d-flex gap-1">
      <% if (page > 1) { %>
        <a href="?page=<%= page-1 %>&search=<%= query.search %>&task_id=<%= query.task_id %>"
           class="btn btn-sm btn-outline-secondary py-0 px-2">‹ Prev</a>
      <% } %>
      <% if (page < pages) { %>
        <a href="?page=<%= page+1 %>&search=<%= query.search %>&task_id=<%= query.task_id %>"
           class="btn btn-sm btn-outline-secondary py-0 px-2">Next ›</a>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/layout_end') %>

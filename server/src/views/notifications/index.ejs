<%- include('../partials/layout_start') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div class="page-heading">Notifications</div>
  <% if (notifications && notifications.some(n => !n.is_read)) { %>
  <form method="POST" action="<%= basePath %>/notifications/read-all">
    <button type="submit" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-check2-all me-1"></i>Mark all as read
    </button>
  </form>
  <% } %>
</div>

<div class="card border-0 shadow-sm">
  <% if (!notifications || notifications.length === 0) { %>
    <div class="p-5 text-center text-muted">
      <i class="bi bi-bell-slash d-block fs-2 mb-2 opacity-50"></i>
      No notifications yet.
    </div>
  <% } else { %>
    <ul class="list-group list-group-flush">
      <% notifications.forEach(n => { %>
        <%
          const isUnread = !n.is_read;
          const typeIcon = {
            assignment: 'bi-person-plus-fill text-primary',
            status:     'bi-arrow-repeat text-warning',
            approval:   'bi-check-circle-fill text-success',
            deadline:   'bi-alarm-fill text-danger',
          }[n.notification_type] || 'bi-bell-fill text-secondary';
        %>
        <li class="list-group-item px-4 py-3 <%= isUnread ? 'bg-primary-subtle' : '' %>">
          <div class="d-flex align-items-start gap-3">
            <!-- Icon -->
            <i class="bi <%= typeIcon %> mt-1 flex-shrink-0" style="font-size:1.1rem;"></i>

            <!-- Body -->
            <div style="min-width:0;flex:1;">
              <div class="fw-semibold small"><%= n.title %></div>
              <div class="text-muted small text-truncate"><%= n.message %></div>
              <div class="text-muted" style="font-size:.7rem;">
                <%= new Date(n.created_at).toLocaleString() %>
              </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 flex-shrink-0">
              <% if (n.reference_id) { %>
                <!-- Mark read and go to task in one POST -->
                <form method="POST" action="<%= basePath %>/notifications/<%= n.notification_id %>/read">
                  <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2"
                          title="View task">
                    <i class="bi bi-box-arrow-up-right"></i>
                  </button>
                </form>
              <% } %>
              <% if (isUnread) { %>
                <form method="POST" action="<%= basePath %>/notifications/<%= n.notification_id %>/read">
                  <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2"
                          title="Mark as read">
                    <i class="bi bi-check2"></i>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>

    <!-- Pagination -->
    <% if (pages > 1) { %>
    <div class="d-flex justify-content-between align-items-center px-4 py-2 border-top small">
      <span class="text-muted">Page <%= page %> of <%= pages %> (<%= total %> total)</span>
      <div class="d-flex gap-1">
        <% if (page > 1) { %>
          <a href="?page=<%= page-1 %>" class="btn btn-sm btn-outline-secondary py-0 px-2">‹ Prev</a>
        <% } %>
        <% if (page < pages) { %>
          <a href="?page=<%= page+1 %>" class="btn btn-sm btn-outline-secondary py-0 px-2">Next ›</a>
        <% } %>
      </div>
    </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/layout_end') %>

<%- include('../partials/layout_start') %>

<div class="page-heading mb-4">Departments</div>

<div class="row g-4">
  <!-- Add form -->
  <div class="col-md-5">
    <div class="card border-0 shadow-sm p-4">
      <h6 class="fw-semibold mb-3">New Department</h6>
      <form method="POST" action="/admin/departments">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Name <span class="text-danger">*</span></label>
          <input name="department_name" class="form-control" required />
        </div>
        <div class="mb-4">
          <label class="form-label small fw-semibold">Description</label>
          <textarea name="description" class="form-control" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Save</button>
      </form>
    </div>
  </div>

  <!-- Table -->
  <div class="col-md-7">
    <div class="card border-0 shadow-sm">
      <table class="table table-hover align-middle mb-0 small">
        <thead class="table-light">
          <tr><th>Name</th><th>Description</th><th class="text-center">Employees</th><th></th></tr>
        </thead>
        <tbody>
          <% if (!depts || depts.length === 0) { %>
            <tr><td colspan="4" class="text-center py-4 text-muted">No departments yet.</td></tr>
          <% } %>
          <% (depts || []).forEach(d => { %>
            <tr>
              <td class="fw-semibold"><%= d.department_name %></td>
              <td class="text-muted"><%= d.description || '—' %></td>
              <td class="text-center">
                <span class="badge bg-primary-subtle text-primary"><%= d.dataValues.employeeCount || 0 %></span>
              </td>
              <td class="text-end">
                <!-- Edit trigger -->
                <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1"
                        data-bs-toggle="modal" data-bs-target="#editDeptModal"
                        data-id="<%= d.department_id %>"
                        data-name="<%= d.department_name %>"
                        data-desc="<%= d.description || '' %>">
                  <i class="bi bi-pencil"></i>
                </button>
                <!-- Delete -->
                <form method="POST" action="/admin/departments/<%= d.department_id %>?_method=DELETE" class="d-inline"
                      data-confirm-title="Remove department?"
                      data-confirm-message="Remove &quot;<%= d.department_name %>&quot;? This cannot be undone."
                      data-confirm-ok="Remove"
                      data-confirm-variant="danger">
                  <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit Modal (Bootstrap, no inline JS — populated by app.js) -->
<div class="modal fade" id="editDeptModal" tabindex="-1" aria-labelledby="editDeptModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="POST" id="editDeptForm" action="">
        <input type="hidden" name="_method" value="PUT" />
        <div class="modal-header">
          <h5 class="modal-title" id="editDeptModalLabel">Edit Department</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Name <span class="text-danger">*</span></label>
            <input name="department_name" id="editDeptName" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Description</label>
            <textarea name="description" id="editDeptDesc" class="form-control" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/layout_end') %>

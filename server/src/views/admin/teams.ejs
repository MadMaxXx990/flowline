<%- include('../partials/layout_start') %>

<div class="page-heading mb-4">Teams</div>

<div class="row g-4">
  <!-- Add form -->
  <div class="col-md-5">
    <div class="card border-0 shadow-sm p-4">
      <h6 class="fw-semibold mb-3">New Team</h6>
      <form method="POST" action="/admin/teams">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Team Name <span class="text-danger">*</span></label>
          <input name="team_name" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
          <select name="department_id" class="form-select" required
                  id="newTeamDept" data-team-dept-select data-employees-json="<%- JSON.stringify(employees.map(e=>({id:e.employee_id,name:e.first_name+' '+e.last_name,dept:e.department_id}))) %>">
            <option value="">Select…</option>
            <% (depts || []).forEach(d => { %>
              <option value="<%= d.department_id %>"><%= d.department_name %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-4">
          <label class="form-label small fw-semibold">Team Lead <span class="text-muted">(optional)</span></label>
          <select name="team_lead_id" class="form-select" id="newTeamLead" data-team-lead-select disabled>
            <option value="">None</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Save</button>
      </form>
    </div>
  </div>

  <!-- Table -->
  <div class="col-md-7">
    <div class="card border-0 shadow-sm">
      <table class="table table-hover align-middle mb-0 small">
        <thead class="table-light">
          <tr><th>Team Name</th><th>Department</th><th>Team Lead</th><th class="text-center">Members</th><th></th></tr>
        </thead>
        <tbody>
          <% if (!teams || teams.length === 0) { %>
            <tr><td colspan="5" class="text-center py-4 text-muted">No teams yet.</td></tr>
          <% } %>
          <% (teams || []).forEach(t => { %>
            <tr>
              <td class="fw-semibold"><%= t.team_name %></td>
              <td class="text-muted"><%= t.department ? t.department.department_name : '—' %></td>
              <td class="text-muted">
                <% if (t.teamLead) { %><%= t.teamLead.first_name %> <%= t.teamLead.last_name %><% } else { %>—<% } %>
              </td>
              <td class="text-center">
                <span class="badge bg-primary-subtle text-primary">
                  <%= t.members ? t.members.length : 0 %>
                </span>
              </td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1"
                        data-bs-toggle="modal" data-bs-target="#editTeamModal"
                        data-id="<%= t.team_id %>"
                        data-name="<%= t.team_name %>"
                        data-dept="<%= t.department_id %>"
                        data-lead="<%= t.team_lead_id || '' %>">
                  <i class="bi bi-pencil"></i>
                </button>
                <form method="POST" action="/admin/teams/<%= t.team_id %>?_method=DELETE" class="d-inline"
                      data-confirm-title="Remove team?"
                      data-confirm-message="Remove &quot;<%= t.team_name %>&quot;? Members will be unassigned."
                      data-confirm-ok="Remove"
                      data-confirm-variant="danger">
                  <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editTeamModal" tabindex="-1" aria-labelledby="editTeamModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="POST" id="editTeamForm" action="">
        <input type="hidden" name="_method" value="PUT" />
        <div class="modal-header">
          <h5 class="modal-title" id="editTeamModalLabel">Edit Team</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Team Name <span class="text-danger">*</span></label>
            <input name="team_name" id="editTeamName" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
            <select name="department_id" id="editTeamDept" class="form-select" required
                    data-team-dept-select
                    data-employees-json="<%- JSON.stringify(employees.map(e=>({id:e.employee_id,name:e.first_name+' '+e.last_name,dept:e.department_id}))) %>">
              <option value="">Select…</option>
              <% (depts || []).forEach(d => { %>
                <option value="<%= d.department_id %>"><%= d.department_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Team Lead <span class="text-muted">(optional)</span></label>
            <select name="team_lead_id" id="editTeamLead" class="form-select" data-team-lead-select>
              <option value="">None</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/layout_end') %>

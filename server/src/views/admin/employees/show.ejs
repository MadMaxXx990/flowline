<%- include('../../partials/layout_start') %>

<div class="page-heading mb-4">Employee Profile</div>

<%
  const statusMap = { Active:'success', 'On Leave':'warning', Inactive:'secondary', Archived:'danger' };
  const sc = statusMap[emp.status] || 'secondary';
  const initial = (emp.first_name || '?')[0].toUpperCase();
%>

<div class="row g-4">
  <!-- Left column -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm p-4 text-center mb-3">
      <% if (emp.profile_photo_url) { %>
        <img src="/employees/<%= emp.employee_id %>/photo"
             alt="<%= emp.first_name %> photo"
             class="rounded-circle mx-auto mb-3 d-block"
             style="width:80px;height:80px;object-fit:cover;" />
      <% } else { %>
        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold mx-auto mb-3"
             style="width:80px;height:80px;font-size:2rem;">
          <%= initial %>
        </div>
      <% } %>
      <h5 class="fw-bold mb-0"><%= emp.first_name %> <%= emp.last_name %></h5>
      <p class="text-muted small mb-2"><%= emp.position ? emp.position.position_name : '' %></p>
      <span class="badge bg-<%= sc %>-subtle text-<%= sc %> border mb-3"><%= emp.status %></span>
      <div class="d-flex gap-2 justify-content-center">
        <a href="/admin/employees/<%= emp.employee_id %>/edit"
           class="btn btn-sm btn-outline-primary">
          <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="POST" action="/admin/employees/<%= emp.employee_id %>?_method=DELETE"
              data-confirm="Archive <%= emp.first_name %> <%= emp.last_name %>? Their account will be deactivated but all historical records are preserved.">
          <button type="submit" class="btn btn-sm btn-outline-warning">
            <i class="bi bi-archive me-1"></i>Archive
          </button>
        </form>
      </div>
    </div>

    <!-- Info card -->
    <div class="card border-0 shadow-sm p-3 small">
      <% const rows = [
        ['bi-envelope',    'Email',           emp.email],
        ['bi-telephone',   'Phone',           emp.phone || '—'],
        ['bi-building',    'Department',      emp.department ? emp.department.department_name : '—'],
        ['bi-people',      'Team',            emp.team ? emp.team.team_name : '—'],
        ['bi-briefcase',   'Emp. Type',       emp.employment_type || '—'],
        ['bi-calendar',    'Hire Date',       emp.hire_date ? new Date(emp.hire_date).toLocaleDateString() : '—'],
        ['bi-shield-fill', 'Role',            emp.user && emp.user.role ? emp.user.role.role_name : '—'],
        ['bi-person',      'Username',        emp.user ? emp.user.username : '—'],
      ]; %>
      <% rows.forEach(([icon, label, value]) => { %>
        <div class="d-flex align-items-start gap-2 py-2 border-bottom">
          <i class="bi <%= icon %> text-muted mt-1" style="width:16px;"></i>
          <div>
            <div class="text-muted" style="font-size:.7rem;"><%= label %></div>
            <div class="fw-semibold"><%= value %></div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Right column: assigned tasks -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="px-3 pt-3 pb-2 border-bottom fw-semibold small">Assigned Tasks</div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
          <thead class="table-light">
            <tr><th>Task</th><th>Due Date</th><th>Stage</th></tr>
          </thead>
          <tbody>
            <% const assignments = emp.taskAssignments || []; %>
            <% if (assignments.length === 0) { %>
              <tr><td colspan="3" class="text-center py-3 text-muted">No tasks assigned.</td></tr>
            <% } %>
            <% assignments.forEach(a => { %>
              <% if (!a.task) return; %>
              <%
                const due      = a.task.due_date ? new Date(a.task.due_date) : null;
                const overdue  = due && due < new Date();
                const stage    = a.task.stage ? a.task.stage.stage_name : '—';
                const stageMap = {
                  Pending:'secondary', 'In Progress':'primary',
                  'For Review':'warning', Completed:'success', Overdue:'danger'
                };
                const sc2 = stageMap[stage] || 'secondary';
              %>
              <tr>
                <td>
                  <a href="/admin/tasks/<%= a.task.task_id %>"
                     class="fw-semibold text-decoration-none text-dark">
                    <%= a.task.task_title %>
                  </a>
                </td>
                <td class="<%= overdue ? 'text-danger' : '' %>">
                  <%= due ? due.toLocaleDateString() : '—' %>
                </td>
                <td>
                  <span class="badge bg-<%= sc2 %>-subtle text-<%= sc2 %> border"><%= stage %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/layout_end') %>

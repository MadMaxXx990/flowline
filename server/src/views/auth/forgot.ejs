<%- include('../partials/header') %>
<div style="min-height:100vh;background:linear-gradient(135deg,#f0f4ff 0%,#e8ecff 100%);display:flex;align-items:center;justify-content:center;">
  <div style="width:100%;max-width:420px;background:#fff;border-radius:16px;padding:2.5rem;box-shadow:0 8px 32px rgba(79,70,229,.10);border:1px solid rgba(79,70,229,.12);">

    <!-- Brand -->
    <div class="d-flex align-items-center gap-2 mb-4">
      <div class="rounded-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:#4f46e5;">
        <i class="bi bi-diagram-3-fill text-white"></i>
      </div>
      <span style="font-weight:800;font-size:1.1rem;">Flowline</span>
    </div>

    <h5 class="fw-bold mb-1">Forgot your password?</h5>
    <p class="text-muted small mb-4">Enter your username and we'll generate a reset token for you.</p>

    <% if (locals.error) { %>
    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 small mb-3">
      <i class="bi bi-exclamation-circle-fill"></i><%= locals.error %>
    </div>
    <% } %>

    <% if (locals.result) { %>
      <!-- Success state -->
      <div class="alert alert-success small mb-3">
        <i class="bi bi-check-circle-fill me-2"></i><%= locals.result.message %>
      </div>
      <% if (locals.result.demo_token) { %>
      <div class="card border-warning mb-4">
        <div class="card-body py-3 px-3">
          <p class="fw-semibold small mb-1">
            <i class="bi bi-info-circle-fill text-warning me-1"></i>Demo Mode — Reset Token
          </p>
          <p class="text-muted small mb-2"><%= locals.result.demo_note %></p>
          <code class="d-block bg-light p-2 rounded small" style="word-break:break-all;user-select:all;">
            <%= locals.result.demo_token %>
          </code>
        </div>
      </div>
      <% } %>
      <a href="/reset-password" class="btn btn-primary w-100">
        Go to Reset Password <i class="bi bi-arrow-right ms-1"></i>
      </a>
    <% } else { %>
      <form method="POST" action="/forgot-password">
        <div class="mb-4">
          <label class="form-label small fw-semibold">Username</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
            <input type="text" name="username" class="form-control border-start-0" placeholder="your.username"
                   value="<%= locals.username || '' %>" required autofocus />
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold mb-3"
                style="background:#4f46e5;border:none;padding:.65rem;">
          Generate Reset Token
        </button>
        <div class="text-center">
          <a href="/login" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>Back to Login</a>
        </div>
      </form>
    <% } %>

  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div style="min-height:100vh;background:linear-gradient(135deg,#f0f4ff 0%,#e8ecff 100%);display:flex;align-items:center;justify-content:center;">
  <div style="width:100%;max-width:420px;background:#fff;border-radius:16px;padding:2.5rem;box-shadow:0 8px 32px rgba(79,70,229,.10);border:1px solid rgba(79,70,229,.12);">

    <!-- Brand -->
    <div class="d-flex align-items-center gap-2 mb-4">
      <div class="rounded-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:#4f46e5;">
        <i class="bi bi-diagram-3-fill text-white"></i>
      </div>
      <span style="font-weight:800;font-size:1.1rem;">Flowline</span>
    </div>

    <h5 class="fw-bold mb-1">Welcome back</h5>
    <p class="text-muted small mb-4">Sign in to your account to continue.</p>

    <!-- Flash (from redirect) -->
    <%- include('../partials/flash') %>

    <!-- Inline error (wrong password / rate-limit) -->
    <% if (locals.error) { %>
    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 small mb-3">
      <i class="bi bi-exclamation-circle-fill"></i><%= locals.error %>
    </div>
    <% } %>

    <form method="POST" action="/login">
      <div class="mb-3">
        <label class="form-label small fw-semibold">Username</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
          <input type="text" name="username" class="form-control border-start-0" placeholder="your.username"
                 value="<%= locals.username || '' %>" required autofocus />
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label small fw-semibold">Password</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
          <input type="password" name="password" class="form-control border-start-0" placeholder="••••••••" required />
        </div>
      </div>
      <button type="submit" class="btn btn-primary w-100 fw-semibold"
              style="background:#4f46e5;border:none;padding:.65rem;">
        Sign in <i class="bi bi-arrow-right ms-1"></i>
      </button>
      <div class="text-center mt-3">
        <a href="/forgot-password" class="text-muted small">Forgot your password?</a>
      </div>
    </form>

  </div>
</div>
<%- include('../partials/footer') %>

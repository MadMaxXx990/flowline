<%- include('../partials/header') %>
<div style="min-height:100vh;background:linear-gradient(135deg,#f0f4ff 0%,#e8ecff 100%);display:flex;align-items:center;justify-content:center;">
  <div style="width:100%;max-width:420px;background:#fff;border-radius:16px;padding:2.5rem;box-shadow:0 8px 32px rgba(79,70,229,.10);border:1px solid rgba(79,70,229,.12);">

    <!-- Brand -->
    <div class="d-flex align-items-center gap-2 mb-4">
      <div class="rounded-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:#4f46e5;">
        <i class="bi bi-diagram-3-fill text-white"></i>
      </div>
      <span style="font-weight:800;font-size:1.1rem;">Flowline</span>
    </div>

    <% if (locals.success) { %>
      <!-- Success state -->
      <div class="text-center">
        <div class="rounded-circle bg-success d-flex align-items-center justify-content-center mx-auto mb-3"
             style="width:60px;height:60px;">
          <i class="bi bi-check-lg text-white fs-3"></i>
        </div>
        <h5 class="fw-bold mb-2">Password Updated</h5>
        <p class="text-muted small mb-4">Your password has been changed. You can now log in.</p>
        <a href="/login" class="btn btn-primary w-100">Go to Login</a>
      </div>
    <% } else { %>
      <h5 class="fw-bold mb-1">Reset your password</h5>
      <p class="text-muted small mb-4">Paste the reset token you received and set a new password.</p>

      <% if (locals.error) { %>
      <div class="alert alert-danger d-flex align-items-center gap-2 py-2 small mb-3">
        <i class="bi bi-exclamation-circle-fill"></i><%= locals.error %>
      </div>
      <% } %>

      <form method="POST" action="/reset-password">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Reset Token <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
            <input type="text" name="token" class="form-control border-start-0 font-monospace"
                   placeholder="Paste token here…" value="<%= locals.token || '' %>"
                   required autofocus style="font-size:.8rem;" />
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">New Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
            <input type="password" name="new_password" class="form-control border-start-0"
                   placeholder="Min. 6 characters" required />
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label small fw-semibold">Confirm Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock-fill text-muted"></i></span>
            <input type="password" name="confirm" class="form-control border-start-0"
                   placeholder="Repeat new password" required />
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 fw-semibold mb-3"
                style="background:#4f46e5;border:none;padding:.65rem;">
          Set New Password
        </button>
        <div class="text-center">
          <a href="/login" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>Back to Login</a>
        </div>
      </form>
    <% } %>

  </div>
</div>
<%- include('../partials/footer') %>

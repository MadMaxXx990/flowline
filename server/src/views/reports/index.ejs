<%- include('../partials/layout_start') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div class="page-heading">Reports</div>
  <div class="d-flex gap-2">
    <a href="<%= basePath %>/reports/export/excel?<%= new URLSearchParams(query).toString() %>"
       class="btn btn-sm btn-success">
      <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
    </a>
    <a href="<%= basePath %>/reports/export/pdf?<%= new URLSearchParams(query).toString() %>"
       class="btn btn-sm btn-danger">
      <i class="bi bi-file-earmark-pdf me-1"></i>Export PDF
    </a>
  </div>
</div>

<!-- Filter form -->
<div class="card border-0 shadow-sm p-3 mb-4">
  <form method="GET" action="<%= basePath %>/reports" class="row g-2 align-items-end">
    <div class="col-6 col-md-3 col-lg-2">
      <label class="form-label small fw-semibold mb-1">From</label>
      <input type="date" name="date_from" class="form-control form-control-sm" value="<%= query.date_from %>" />
    </div>
    <div class="col-6 col-md-3 col-lg-2">
      <label class="form-label small fw-semibold mb-1">To</label>
      <input type="date" name="date_to" class="form-control form-control-sm" value="<%= query.date_to %>" />
    </div>
    <% if (role === 'Administrator') { %>
    <div class="col-6 col-md-3 col-lg-2">
      <label class="form-label small fw-semibold mb-1">Department</label>
      <select name="department_id" class="form-select form-select-sm">
        <option value="">All</option>
        <% (departments||[]).forEach(d => { %><option value="<%= d.department_id %>" <%= query.department_id==d.department_id?'selected':'' %>><%= d.department_name %></option><% }) %>
      </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
      <label class="form-label small fw-semibold mb-1">Team</label>
      <select name="team_id" class="form-select form-select-sm">
        <option value="">All</option>
        <% (teams||[]).forEach(t => { %><option value="<%= t.team_id %>" <%= query.team_id==t.team_id?'selected':'' %>><%= t.team_name %></option><% }) %>
      </select>
    </div>
    <% } %>
    <div class="col-6 col-md-3 col-lg-2">
      <label class="form-label small fw-semibold mb-1">Stage</label>
      <select name="stage_id" class="form-select form-select-sm">
        <option value="">All</option>
        <% (stages||[]).forEach(s => { %><option value="<%= s.stage_id %>" <%= query.stage_id==s.stage_id?'selected':'' %>><%= s.stage_name %></option><% }) %>
      </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
      <label class="form-label small fw-semibold mb-1">Priority</label>
      <select name="priority_id" class="form-select form-select-sm">
        <option value="">All</option>
        <% (priorities||[]).forEach(p => { %><option value="<%= p.priority_id %>" <%= query.priority_id==p.priority_id?'selected':'' %>><%= p.priority_name %></option><% }) %>
      </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
      <label class="form-label small fw-semibold mb-1">Employee</label>
      <select name="employee_id" class="form-select form-select-sm">
        <option value="">All</option>
        <% (employees||[]).forEach(e => { %><option value="<%= e.employee_id %>" <%= query.employee_id==e.employee_id?'selected':'' %>><%= e.first_name %> <%= e.last_name %></option><% }) %>
      </select>
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary btn-sm">Apply</button>
      <a href="<%= basePath %>/reports" class="btn btn-outline-secondary btn-sm ms-1">Clear</a>
    </div>
  </form>
</div>

<!-- Summary KPIs -->
<div class="row g-3 mb-4">
  <% const kpis = [
    { label:'Total Tasks',           value: totalTasks,             color:'#4f46e5' },
    { label:'Completed',             value: completedTasks,         color:'#10b981' },
    { label:'Overdue',               value: overdueTasks,           color:'#f97316' },
    { label:'Completion Rate',       value: completionRate+'%',     color:'#3b82f6' },
    { label:'On-Time Rate',          value: onTimeRateDisplay,      color:'#10b981' },
    { label:'Avg Completion Time',   value: avgCompletionDisplay,   color:'#8b5cf6' },
  ]; %>
  <% kpis.forEach(k => { %>
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card border-0 shadow-sm p-3 text-center">
      <div style="font-size:1.5rem;font-weight:700;color:<%- k.color %>;"><%= k.value %></div>
      <div class="text-muted small"><%= k.label %></div>
    </div>
  </div>
  <% }) %>
</div>

<!-- Metric definitions note -->
<div class="alert alert-light border small py-2 px-3 mb-4" role="note">
  <strong>Definitions:</strong>
  <em>Completion time</em> = task created_at → timestamp it entered the Completed stage (from stage history).
  <em>On-time</em> = completed at or before the end of the task's due date.
  <em>On-time completion rate</em> = on-time completed ÷ all completed tasks in the filtered set.
  <em>Average completion time</em> = mean completion time over completed tasks in the filtered set.
  "No data" is shown when there are no completed tasks.
</div>

<!-- Charts row -->
<div class="row g-4 mb-4">

  <!-- Tasks by Stage — horizontal bar -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm p-3">
      <div class="fw-semibold small mb-2">Tasks by Stage</div>
      <%
        const rStageOrder  = ['Pending','In Progress','For Review','Completed','Overdue'];
        const rStageMap    = Object.fromEntries((stageCounts||[]).map(s=>[s.stage,s.count]));
        const rStageLabels = rStageOrder;
        const rStageVals   = rStageOrder.map(s => rStageMap[s] ?? 0);
        const rStageTotal  = rStageVals.reduce((a,v)=>a+v,0);
        const rStageMx     = rStageVals.reduce((mi,v,i)=>v>rStageVals[mi]?i:mi,0);
      %>
      <% if (rStageTotal === 0) { %>
        <p class="text-muted small py-4 text-center mb-0">No tasks yet.</p>
      <% } else { %>
      <div class="chart-box">
        <canvas id="stageChart"
                role="img"
                aria-label="Tasks by stage: <%- rStageLabels.map((l,i)=>l+' '+rStageVals[i]).join(', ') %>"
                data-chart-type="hbar"
                data-chart-title="Tasks by Stage"
                data-chart-labels="<%- JSON.stringify(rStageLabels) %>"
                data-chart-values="<%- JSON.stringify(rStageVals) %>"></canvas>
      </div>
      <p class="text-muted small mt-2 mb-0">Most tasks are <strong><%= rStageLabels[rStageMx] %></strong> (<%= rStageVals[rStageMx] %> of <%= rStageTotal %>).</p>
      <% } %>
    </div>
  </div>

  <!-- Tasks by Priority — horizontal bar -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm p-3">
      <div class="fw-semibold small mb-2">Tasks by Priority</div>
      <%
        const rPrioOrder  = ['High','Medium','Low'];
        const rPrioMap    = Object.fromEntries((priorityCounts||[]).map(p=>[p.priority,p.count]));
        const rPrioLabels = rPrioOrder;
        const rPrioVals   = rPrioOrder.map(p => rPrioMap[p] ?? 0);
        const rPrioColors = ['#ef4444','#f59e0b','#10b981'];
        const rPrioTotal  = rPrioVals.reduce((a,v)=>a+v,0);
        const rPrioMx     = rPrioVals.reduce((mi,v,i)=>v>rPrioVals[mi]?i:mi,0);
      %>
      <% if (rPrioTotal === 0) { %>
        <p class="text-muted small py-4 text-center mb-0">No tasks yet.</p>
      <% } else { %>
      <div class="chart-box">
        <canvas id="priorityChart"
                role="img"
                aria-label="Tasks by priority: <%- rPrioLabels.map((l,i)=>l+' '+rPrioVals[i]).join(', ') %>"
                data-chart-type="hbar"
                data-chart-title="Tasks by Priority"
                data-chart-labels="<%- JSON.stringify(rPrioLabels) %>"
                data-chart-values="<%- JSON.stringify(rPrioVals) %>"
                data-chart-colors="<%- JSON.stringify(rPrioColors) %>"></canvas>
      </div>
      <p class="text-muted small mt-2 mb-0">Most tasks are <strong><%= rPrioLabels[rPrioMx] %></strong> priority (<%= rPrioVals[rPrioMx] %> of <%= rPrioTotal %>).</p>
      <% } %>
    </div>
  </div>

  <!-- Attendance Summary — horizontal bar -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm p-3">
      <div class="fw-semibold small mb-2">Attendance Summary</div>
      <%
        const attLabels = (attSummary||[]).map(a=>a.attendance_status);
        const attVals   = (attSummary||[]).map(a=>+a.cnt);
        const attColors = {'Present':'#10b981','Late':'#f59e0b','Absent':'#ef4444','On Leave':'#9ca3af'};
        const attHex    = attLabels.map(l=>attColors[l]||'#6b7280');
        const attTotal  = attVals.reduce((a,v)=>a+v,0);
        const attMx     = attVals.length ? attVals.reduce((mi,v,i)=>v>attVals[mi]?i:mi,0) : 0;
      %>
      <% if (attTotal === 0) { %>
        <p class="text-muted small py-4 text-center mb-0">No attendance data.</p>
      <% } else { %>
      <div class="chart-box">
        <canvas id="attChart"
                role="img"
                aria-label="Attendance summary: <%- attLabels.map((l,i)=>l+' '+attVals[i]).join(', ') %>"
                data-chart-type="hbar"
                data-chart-title="Attendance Summary"
                data-chart-labels="<%- JSON.stringify(attLabels) %>"
                data-chart-values="<%- JSON.stringify(attVals) %>"
                data-chart-colors="<%- JSON.stringify(attHex) %>"></canvas>
      </div>
      <p class="text-muted small mt-2 mb-0">Most records are <strong><%= attLabels[attMx] %></strong> (<%= attVals[attMx] %> of <%= attTotal %>).</p>
      <% } %>
    </div>
  </div>

</div>

<!-- Employee performance table -->
<div class="card border-0 shadow-sm mb-4">
  <div class="px-3 pt-3 pb-2 border-bottom fw-semibold small">Employee Performance
    <span class="text-muted fw-normal">(<%= perfTotal %> employees)</span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 small">
      <thead class="table-light">
        <tr>
          <th>Employee</th>
          <th>Department</th>
          <th class="text-center">Assigned</th>
          <th class="text-center">Completed</th>
          <th class="text-center">Overdue</th>
          <th class="text-center">Rate</th>
          <th class="text-center">On-Time Rate</th>
          <th class="text-center">Avg Completion</th>
        </tr>
      </thead>
      <tbody>
        <% if (!performance || !performance.length) { %>
          <tr><td colspan="8" class="text-center py-4 text-muted">No data for selected filters.</td></tr>
        <% } %>
        <% (performance||[]).forEach(r => { %>
          <tr>
            <td class="fw-semibold"><%= r.employee.first_name %> <%= r.employee.last_name %></td>
            <td class="text-muted"><%= r.employee.department?.department_name || '—' %></td>
            <td class="text-center"><%= r.assigned %></td>
            <td class="text-center"><%= r.completed %></td>
            <td class="text-center <%= r.overdue > 0 ? 'text-danger fw-semibold' : '' %>"><%= r.overdue %></td>
            <td class="text-center">
              <span class="badge <%= r.completion_rate >= 80 ? 'bg-success' : r.completion_rate >= 50 ? 'bg-warning text-dark' : 'bg-danger' %>">
                <%= r.completion_rate %>%
              </span>
            </td>
            <td class="text-center small"><%= r.on_time_rate_display || 'No data' %></td>
            <td class="text-center small"><%= r.avg_completion_display || 'No data' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <!-- Pagination -->
  <% if (perfPages > 1) { %>
  <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top small">
    <span class="text-muted">Page <%= perfPage %> of <%= perfPages %></span>
    <div class="d-flex gap-1">
      <% if (perfPage > 1) { %><a href="?<%= new URLSearchParams({...query, page: perfPage-1}).toString() %>" class="btn btn-sm btn-outline-secondary py-0 px-2">‹ Prev</a><% } %>
      <% if (perfPage < perfPages) { %><a href="?<%= new URLSearchParams({...query, page: perfPage+1}).toString() %>" class="btn btn-sm btn-outline-secondary py-0 px-2">Next ›</a><% } %>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/layout_end') %>

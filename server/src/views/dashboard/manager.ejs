<%- include('../partials/layout_start') %>

<div class="page-heading mb-4">Manager Dashboard</div>

<!-- KPI row -->
<div class="row g-3 mb-4">
  <% const kpis = [
    { label:'My Tasks',       value: totalTasks,      icon:'bi-kanban-fill',       color:'#4f46e5' },
    { label:'Completed',      value: completedCount,  icon:'bi-check-circle-fill', color:'#10b981' },
    { label:'Overdue',        value: overdueCount,    icon:'bi-alarm-fill',        color:'#f97316' },
    { label:'Pending Review', value: pendingApproval, icon:'bi-eye-fill',          color:'#f59e0b' },
  ]; %>
  <% kpis.forEach(k => { %>
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3">
      <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
           style="width:44px;height:44px;background:<%- k.color %>20;">
        <i class="bi <%= k.icon %>" style="color:<%- k.color %>;font-size:1.2rem;"></i>
      </div>
      <div>
        <div style="font-size:1.5rem;font-weight:700;line-height:1.1;"><%= k.value %></div>
        <div class="text-muted small"><%= k.label %></div>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<div class="row g-4 mb-4">

  <!-- Weekly completions — vertical bar -->
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm p-4">
      <div class="fw-semibold small mb-3">Completed Tasks — Last 7 Days</div>
      <% if (weeklyChart.reduce((a,d)=>a+d.count,0) === 0) { %>
        <p class="text-muted small py-4 text-center mb-0">No completed tasks in the last 7 days.</p>
      <% } else { %>
      <div class="chart-box-sm">
        <canvas id="weeklyChart"
                role="img"
                aria-label="Completed tasks last 7 days: <%- weeklyChart.map(d=>d.label+' '+d.count).join(', ') %>"
                data-chart-type="bar"
                data-chart-title="Completed Tasks — Last 7 Days"
                data-chart-labels="<%- JSON.stringify(weeklyChart.map(d=>d.label)) %>"
                data-chart-values="<%- JSON.stringify(weeklyChart.map(d=>d.count)) %>"
                data-chart-color="#4f46e5"></canvas>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Tasks by Stage — horizontal bar -->
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm p-4">
      <div class="fw-semibold small mb-2">My Tasks by Stage</div>
      <%
        const stageOrder = ['Pending','In Progress','For Review','Completed','Overdue'];
        const stageMap   = Object.fromEntries((stageCounts||[]).map(s=>[s.stage,s.count]));
        const stageLabels = stageOrder;
        const stageVals   = stageOrder.map(s => stageMap[s] ?? 0);
        const stageTotal  = stageVals.reduce((a,v)=>a+v,0);
        const stageMaxIdx = stageVals.reduce((mi,v,i)=>v>stageVals[mi]?i:mi,0);
      %>
      <% if (stageTotal === 0) { %>
        <p class="text-muted small py-4 text-center mb-0">No tasks yet.</p>
      <% } else { %>
      <div class="chart-box">
        <canvas id="stageChart"
                role="img"
                aria-label="My tasks by stage: <%- stageLabels.map((l,i)=>l+' '+stageVals[i]).join(', ') %>"
                data-chart-type="hbar"
                data-chart-title="My Tasks by Stage"
                data-chart-labels="<%- JSON.stringify(stageLabels) %>"
                data-chart-values="<%- JSON.stringify(stageVals) %>"></canvas>
      </div>
      <p class="text-muted small mt-2 mb-0">Most tasks are <strong><%= stageLabels[stageMaxIdx] %></strong> (<%= stageVals[stageMaxIdx] %> of <%= stageTotal %>).</p>
      <% } %>
    </div>
  </div>

</div>

<!-- Recent tasks -->
<div class="card border-0 shadow-sm mb-4">
  <div class="px-3 pt-3 pb-2 border-bottom fw-semibold small">Recent Tasks</div>
  <table class="table table-hover align-middle mb-0 small">
    <thead class="table-light"><tr><th>Title</th><th>Stage</th><th>Due</th></tr></thead>
    <tbody>
      <% if (!recentTasks || !recentTasks.length) { %>
        <tr><td colspan="3" class="text-center text-muted py-3">No tasks yet.</td></tr>
      <% } %>
      <% (recentTasks||[]).forEach(t => { %>
        <% const sm={Pending:'secondary','In Progress':'primary','For Review':'warning',Completed:'success',Overdue:'danger'}; %>
        <tr>
          <td><a href="/manager/tasks/<%= t.task_id %>" class="text-decoration-none text-dark fw-semibold">
            <%= t.task_title.length>40 ? t.task_title.slice(0,40)+'…' : t.task_title %></a></td>
          <td><span class="badge bg-<%= sm[t.stage?.stage_name]||'secondary' %>-subtle text-<%= sm[t.stage?.stage_name]||'secondary' %> border"><%= t.stage?.stage_name||'—' %></span></td>
          <td class="text-muted"><%= t.due_date ? new Date(t.due_date).toLocaleDateString() : '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/layout_end') %>

<%- include('../partials/header') %>
<div style="display:flex;">
  <%- include('../partials/sidebar') %>

  <div style="margin-left:250px;flex:1;min-height:100vh;background:#f5f6fa;">
    <!-- Topbar -->
    <header style="position:sticky;top:0;z-index:1030;background:#fff;border-bottom:1px solid #e9ecef;padding:0 1.5rem;height:60px;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-weight:700;font-size:1rem;color:#1e1b4b;">Flowline</span>
      <span class="text-muted small d-none d-md-inline" id="topbar-date"></span>
    </header>

    <!-- Page content -->
    <main style="padding:1.75rem 2rem;">
      <%- include('../partials/flash') %>
      <div class="page-heading mb-4">Dashboard</div>
      <div class="card border-0 shadow-sm p-4 text-center" style="max-width:480px;margin:2rem auto;">
        <i class="bi bi-speedometer2 text-primary mb-3" style="font-size:3rem;"></i>
        <h5 class="fw-bold mb-2"><%= role %> Dashboard</h5>
        <p class="text-muted small mb-0">Dashboard content is coming in a later phase.</p>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>

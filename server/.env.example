# ─────────────────────────────────────────────────────────────────────────────
# Flowline — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/flowline_db"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use a strong random value in production.
JWT_SECRET="replace-this-with-a-strong-secret-32-chars-minimum"
JWT_EXPIRES_IN="8h"

# ── Cookie signing ────────────────────────────────────────────────────────────
# Signs the flash-message cookie. Use a different value from JWT_SECRET.
# Must be at least 32 characters.
COOKIE_SECRET="replace-this-with-another-strong-secret-32-chars"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Background jobs ───────────────────────────────────────────────────────────
# How often the overdue-task and deadline-reminder jobs run (minutes).
OVERDUE_CHECK_MINUTES=15

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Set to "1" (or a specific IP/CIDR) when running behind nginx / a load
# balancer so the rate-limiter keys on the real client IP instead of the
# proxy's address. Leave unset or "false" in direct-to-internet deployments.
# TRUST_PROXY=1

# ── Demo / development flags ──────────────────────────────────────────────────
# Set to "true" ONLY in demo/thesis environments to expose the password-reset
# token directly in the HTTP response (simulates the email step).
# NEVER set this to true in production.
# DEMO_RESET_TOKEN=true
